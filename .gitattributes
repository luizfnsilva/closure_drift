# This project's whole subject is byte identity. A checkout that rewrites line endings
# would break DEPOSIT.sha256 and make the deposit unverifiable on that machine.
* text=auto eol=lf
*.py   text eol=lf
*.md   text eol=lf
*.cff  text eol=lf
*.json text eol=lf
LICENSE text eol=lf
NOTICE  text eol=lf
VERSION text eol=lf
DEPOSIT.sha256 text eol=lf
